{
  "type": "object",
  "required": [
    "environment",
    "service_name",
    "team_owner",
    "port",
    "database",
    "module_path"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "service_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*$",
      "description": "Service name. Spaces and underscores are normalized to hyphens by the plugin."
    },
    "team_owner": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "image_tag": {
      "type": "string",
      "minLength": 1
    },
    "module_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
